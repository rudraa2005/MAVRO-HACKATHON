FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=flowguard-dev-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowguard
FLOWGUARD_PLACE=Chennai, India
AUTO_INGEST=false
ENABLE_SIMULATION=true
VEHICLE_COUNT=30
WRONG_WAY_COUNT=2
WRONG_WAY_DURATION_SECONDS=30
SIMULATION_INTERVAL_SECONDS=0.5
GPS_NOISE_METERS=6.0
SIMULATION_RANDOM_SEED=42
FRONTEND_POLL_INTERVAL_MS=1000
